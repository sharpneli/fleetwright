// Doctrine's presets (docs/battle/command.md "Doctrine: the standing rules", decision 7): named sets of values. A
// scenario's side takes one ("doctrine": { "Britain": "default" }, else "default") and may set fields over it, per side
// and per unit. A field not given is the neutral default (Fleetwright.Sim.Ai/Doctrine.cs: carry on, never fall out).
// Presets by navy and year (the British at long range, the Germans' battle turn-away) come with the fine-tuning pass.
{
  "default": {
    // what a unit does when it first meets an enemy in sight: "fight" (Fight, turning away when outgunned) or "carry on"
    "Engage": "fight",
    // Fight's range, a share of the main battery's reach; Fight turns away once the unit's matchup against the enemy
    // (docs/battle/command.md 5.1g: the share of his tonnage it puts out of the fight for the share of its own) is under
    // 1 / OutgunnedRatio, and the commander declines battle by it; he sends units after an enemy at SeekRatio or better
    "RangeShare": 0.6,
    "OutgunnedRatio": 2,
    "SeekRatio": 1,
    // a ship falls out of the line under 60% of its designed speed, a third of its main guns, past 10° of list, or with
    // half its reserve buoyancy flooded
    "FallOutSpeedShare": 0.6,
    "FallOutGunsShare": 0.34,
    "FallOutListDeg": 10,
    "FallOutWaterShare": 0.5,
    // torpedoes "at will" or "on order" (only at a ship it's ordered to engage)
    "Torpedoes": "at will",
    // under fire: "steady" or "zigzag" (30° either side of the course wanted, 75 s legs), when running from fire beyond
    // 10 km, and a torpedo craft on its run-in (research/simulation/evasion-research.md §10)
    "Evasion": "zigzag",
    "EvadeDeg": 30,
    "EvadeLegS": 75,
    "EvadeBeyondM": 10000,
    // a torpedo her lookouts see coming at her: "none", or "comb" its track
    "TorpedoEvasion": "comb",
    // a line that sees a torpedo attack coming (enemy torpedo craft closing within 8 km, or tracks seen) turns away together
    // through 4 points (the Grand Fleet's answer), and back three minutes after it's past; 0 holds on
    "TurnAwayDeg": 45,
    // torpedo craft in a group attack "together" (gain a position ahead of the target's beam, run in, fire on one signal,
    // turn away together) or "alone" (each boat on her own); a flotilla that has lost half its boats is beaten off
    "TorpedoAttack": "together",
    "AttackBreakOffShare": 0.5,
    // a force in a cruising order (columns abreast) meeting the enemy's main body forms one line of battle across his course
    "Deploy": 1,
    // a side's commander breaks off, every unit for home, once a third of the tonnage it came with is lost
    "BreakOffShare": 0.34,
    // by night (the sun more than 6° down) heavy ships "avoid" action (withdrawn from contact, the scouts keeping in touch)
    // or "accept" it; torpedo craft attack by night (1) any heavy enemy in reach, or not (0)
    "NightAction": "avoid",
    "NightAttack": 1,
    // a force's admiral disposes what he has (docs/battle/admirals-orders.md O7): his scouts scout ahead of his main body,
    // his flotillas and screens screen it (1); or he keeps every squadron in his line (0)
    "Dispose": 1,
    // each battery loads the shell its target calls for, "by target" (the captain judges what a round does to her as he
    // has her made out, docs/battle/shell-choice.md), or fires "by the magazine order" (a main battery AP until it's
    // spent, a secondary HE)
    "Shells": "by target",
    // a secondary battery at will takes only a ship it hits with 1% of its shells or more (the matchup's estimate by its
    // fire control, the ship as made out, at her range; 0: anything in reach): a 6" by eye on a battleship to about
    // 10 km, on a torpedo-boat destroyer to about 7 km, never splashing at 12 km
    "SecondaryHitFloor": 0.01,
    // a secondary's casemated and its open guns closed up (docs/battle/crew.md N3a): "always", "in range" (an enemy worth
    // their fire in reach and bearing) or "torpedo craft" (only those in reach, a watch of two guns a battery meanwhile);
    // the rest of the time their crews wait under cover, the reserve the reliefs come from [EST: the RN at Jutland]
    "ManCasemates": "in range",
    "ManOpenGuns": "in range",
    // reliefs from the men under cover and the idle hands, a live mount's handling room kept ("handling room protected"),
    // or "reserve in supply" (the USN's 1899 bill: the supply's spare men first)
    "ReliefOrder": "handling room protected",
    // a ship seen done for (burning, her guns silent a while, stopped) with nothing else in reach: "cease" fire on her
    // (rounds kept for the next fight) or "finish" her (docs/battle/crew.md N5b; the user: no fire on burning wrecks that
    // show no sign of life); any other target in reach comes first either way, and a gun of hers seen firing brings it back
    "Wrecks": "cease",
    // a ship in sight that can't be made out, friend or foe (docs/battle/night.md Q6): "challenge" her with the bridge
    // lamp first (unanswered she's a foe; the lamp shows the challenger), "hold fire" until she's made out or gives herself
    // away (fires on one of ours, lights one, challenges), or "fire"; a bold captain fires anyway where no friend is
    // about her. Most of the era's navies challenged or held fire [EST until the research]
    "Unknowns": "challenge",
    // the share of the enemy's challenges a side's ships can answer with his reply, taken for friends (0: none known)
    "AnswerChallenge": 0,
    // at night (docs/battle/night.md Q7) [EST until the research; one a period in the tuning pass]: searchlights "never",
    // "when fired on", "to fire" (on a target the guns can't see) or "search" (sweeping for torpedo craft as well); star
    // shell "never", "to fire" or "to find" (a contact held but not seen or not made out, as well); challenge a ship not
    // made out only within ChallengeM (farther off, keep dark); lit by an enemy's beam or a flare, "fight on" or "turn
    // away" (lights out, stern to the light for two minutes)
    "Searchlights": "to fire",
    "StarShell": "to fire",
    "ChallengeM": 2500,
    "WhenLit": "turn away",
    // a squadron closes up at night (the sun 6° down) to this share of its day's spacing, each ship keeping her next ahead
    // in sight [EST]; one that loses sight of her next ahead holds the course and speed she had until she sees her again
    "NightSpacingShare": 0.5
  }
}
