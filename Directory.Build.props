<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Number formatting must not follow the player's culture (PORTING.md, "What the earlier plan missed" 6). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ContentRoot>$(MSBuildThisFileDirectory)Content\</ContentRoot>
    <!-- DevRelease: optimized like Release, but the game keeps its console and Tracy (src/Fleetwright/Fleetwright.csproj). -->
    <Configurations>Debug;Release;DevRelease</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DevRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Fleetwright.Shipgen'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
