<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fleetwright.Shipgen.Cli</RootNamespace>
    <AssemblyName>shipgen</AssemblyName>
    <PublishAot>true</PublishAot>
    <!-- capture and golden-check build many ships in parallel: one heap per core keeps them from queueing on the GC -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleetwright.Shipgen\Fleetwright.Shipgen.csproj" />
    <ProjectReference Include="..\Fleetwright.Shipgen.Render\Fleetwright.Shipgen.Render.csproj" />
    <!-- a tool may depend on anything; the libraries may not (docs/battle/plan.md, "The code, checked again") -->
    <ProjectReference Include="..\Fleetwright.Sim\Fleetwright.Sim.csproj" />
    <ProjectReference Include="..\Fleetwright.Sim.Ships\Fleetwright.Sim.Ships.csproj" />
    <ProjectReference Include="..\Fleetwright.Sim.Combat\Fleetwright.Sim.Combat.csproj" />
  </ItemGroup>

</Project>
