    "kronstadt": {
      "desc": "Russia-inspired",
      "eras": {
        // Russia-inspired 1890s-1905, the Second Pacific Squadron at Tsushima: black all over, hull and upperworks,
        // ochre-yellow funnels with a broad black band round the top, round French-type turrets (the Tsesarevich and
        // Borodinos; give the design a tumblehome, hull.section), military masts with fighting tops, coal-dusted teak
        "victorian": {
          "from": "generic/victorian",
          "desc": "Russia-inspired 1890s-1905: Tsushima black all over, yellow funnels with black tops",
          "palette": {
            "hull": "#1a1a1c", "deck": "#3a3632", "wood": "#a8926c", "deck_line": "#5a4a33", "steel_line": "#2a2622",
            "levels": ["#262628", "#2d2d2f", "#343436", "#3b3b3d"], "turret": "#2a2a2c", "barbette": "#333335",
            "barrel": "#161617", "tub": "#2a2a2c", "funnel": "#d6a73c", "funnel_cap": "#141414",
            "funnel_band": "#141414", "boat": "#d9d4c6", "fitting": "#3a3631", "mast": "#262422", "crane": "#2a2a2c"
          },
          "turrets": "round",
          "shapes": {"funnel": "oval", "funnel_band_w": 0.3, "funnel_band_h": 3.2}
        },
        // Russia-inspired 1910s, the Baltic two-tone of 1912: dark grey hull sides under light grey upperworks, pale
        // scrubbed pine decks, bare pole masts (the Ganguts carried no tops), the broad funnel bands the Baltic kept
        // through the war
        "great_war": {
          "from": "generic/great_war",
          "desc": "Russia-inspired 1910s: dark hull under light grey, pale pine decks, bare pole masts, broad funnel bands",
          "palette": {"funnel_band": "#1c1d1e"},
          "adjust": [
            {"keys": "hull", "lighten": -0.12, "styles": ["warship", "carrier", "planing"]},
            {"keys": ["upperworks", "armament", "funnels"], "lighten": 0.32, "styles": ["warship", "carrier", "planing"]},
            {"keys": "wood", "tint": ["#cdc2a3", 1.0], "styles": ["warship", "carrier", "planing"]},
            {"keys": "deck_line", "tint": ["#8c7a58", 1.0], "styles": ["warship", "carrier", "planing"]}
          ],
          "turrets": "classic",
          "shapes": {"funnel": "oval", "funnel_band_w": 1.0, "deck_line_opacity": 0.5}
        },
        // Russia-inspired 1920s-30s, the new Red fleet: the old dreadnoughts rebuilt with round tower bridges and a
        // capped fore funnel raked aft (Marat, Parizhskaya Kommuna), mid grey, grey-washed pine, red funnel bands
        "treaty": {
          "from": "generic/treaty",
          "desc": "Russia-inspired 1920s-30s: Soviet grey, tower bridges, raked capped funnels, red funnel bands",
          "palette": {"funnel_band": "#a8322a"},
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "lighten": -0.06, "styles": ["warship", "carrier", "planing"]},
            {"keys": "wood", "tint": ["#b3ab96", 1.0], "styles": ["warship", "carrier", "planing"]},
            {"keys": "deck_line", "tint": ["#6e6656", 1.0], "styles": ["warship", "carrier", "planing"]}
          ],
          "shapes": {"blocks": "tower", "funnel_band_w": 0.8, "funnel_rake": 1.2, "funnel_cap": "hat"},
          "shapes_by_style": {"merchant": {"funnel_rake": 0.0, "funnel_cap": null, "blocks": "soft"}}
        },
        // Russia-inspired: the Soviet fleet at war, as camouflaged in Leningrad and the Black Sea: green-grey under
        // dark green and black disruptive panels carried across the decks against the bombers, tower bridges,
        // round turrets, tripods with director tops
        "wwii": {
          "desc": "Russia-inspired: green-grey under green and black panels, decks too, tower bridges, round turrets",
          "palette": {
            "hull": "#5a625c", "deck": "#5f6560", "wood": "#a9a089", "deck_line": "#4f4a3e", "steel_line": "#3c423d",
            "levels": ["#7c847d", "#89908a", "#959c96", "#a1a8a2"], "turret": "#7e867f", "barbette": "#5e665f",
            "barrel": "#363b37", "tub": "#6a726b", "funnel": "#7c847d", "funnel_cap": "#1d201e",
            "funnel_band": "#1d201e", "boat": "#a3aaa3", "fitting": "#555c56", "mast": "#2c312d",
            "flight_deck": "#5f665d", "stripe": "#e4c64a", "marking": "#eef0ea",
            "camo": ["#2f3a30", "#1c1f1d", "#9aa49b"]
          },
          "by_style": {
            "merchant": {
              "hull": "#1e1f1f", "deck": "#8a7e6a", "deck_line": "#4a4234",
              "levels": ["#e6e4dc", "#ebe9e2", "#efede7", "#f3f2ed"], "funnel": "#1d1d1d", "funnel_band": "#b3332a",
              "hatch": "#4f5446", "mast": "#3a3027"
            },
            "planing": {
              "hull": "#5a625c", "deck": "#6a716b", "deck_line": "#3c423d",
              "levels": ["#7c847d", "#89908a", "#959c96", "#a1a8a2"]
            }
          },
          "turrets": "round",
          "shapes": {
            "blocks": "tower", "funnel": "oval", "funnel_band_w": 0.5,
            "dazzle": true, "dazzle_decks": 0.45, "dazzle_upperworks": 0.7
          },
          "shapes_by_style": {
            "merchant": {"blocks": "soft", "dazzle": false}
          }
        },
        // Russia-inspired 1950s-60s: light Soviet grey over red-brown non-skid, the red-brown teak to match, capped
        // funnels with black tops, lattice masts, round turrets. Merchants: black hull, white house, red funnel with
        // a black top
        "cold_war": {
          "from": "generic/cold_war",
          "desc": "Russia-inspired 1950s-60s: light grey, red-brown decks, lattice masts, black-topped funnels",
          "palette": {
            "deck": "#6b3f33", "steel_line": "#45281f", "wood": "#8a5444", "deck_line": "#4e2e24", "flight_deck": "#5a3a32",
            "funnel_band": "#1a1c1e", "funnel_cap": "#1a1c1e"
          },
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "lighten": 0.1, "styles": ["warship", "carrier", "planing"]}
          ],
          "by_style": {
            "merchant": {
              "hull": "#1c1c1d", "deck": "#8a5444", "deck_line": "#4e2e24",
              "levels": ["#eceae3", "#f0eee8", "#f3f2ed", "#f6f5f1"], "funnel": "#b8352b", "funnel_band": "#161616",
              "hatch": "#4d5146", "mast": "#3a3027"
            }
          },
          "turrets": "round",
          "shapes": {"funnel": "capped", "funnel_band_w": 0.8, "blocks": "soft"}
        }
      }
    },
    "suomenlinna": {
      "desc": "Finland-inspired",
      "eras": {
        // Finland-inspired 1890s-1900s, the Grand Duchy's squadron that never was: a pine-tar black hull (Finland
        // tarred the world's ships), birch-white upperworks, pale scrubbed pine, white funnels with a Finnish-blue
        // band under a black top, tarred masts, round turrets
        "victorian": {
          "from": "generic/victorian",
          "desc": "Finland-inspired 1890s-1900s: tar-black hull, birch-white upperworks, white funnels with a blue band",
          "palette": {
            "hull": "#221b16", "deck": "#5c5144", "wood": "#ddd0ac", "deck_line": "#8f7b55", "steel_line": "#3a3128",
            "levels": ["#ebe7dc", "#efebe2", "#f2efe8", "#f5f3ee"], "funnel": "#eeeae0", "funnel_band": "#1f4a8a",
            "funnel_cap": "#161412", "mast": "#4a3524", "turret": "#2a2420", "barbette": "#352d27", "tub": "#2a2420"
          },
          "turrets": "round",
          "shapes": {"funnel": "oval", "funnel_band_w": 0.4, "funnel_band_h": 2.0}
        },
        // Finland-inspired 1910s, the navy of 1918 in ice-field dazzle: white, ice blue and slate panels over a pale
        // blue-grey, a little across the decks, broken pack ice rather than the Atlantic's stripes; pale pine,
        // classic turrets
        "great_war": {
          "from": "generic/great_war",
          "desc": "Finland-inspired 1910s: ice-field dazzle in white, ice blue and slate over pale blue-grey",
          "palette": {"camo": ["#f1f3f2", "#a9c0d1", "#3f4b57"], "funnel_band": "#24426e"},
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "lighten": 0.35, "styles": ["warship", "carrier", "planing"]},
            {"keys": ["hull", "upperworks", "armament", "funnels"], "tint": ["#b9cad6", 0.25], "styles": ["warship", "carrier", "planing"]},
            {"keys": "wood", "tint": ["#d7cfb8", 1.0], "styles": ["warship", "carrier", "planing"]}
          ],
          "turrets": "classic",
          "shapes": {"funnel": "oval", "dazzle": true, "dazzle_decks": 0.25, "dazzle_upperworks": 1.0}
        },
        // Finland-inspired 1920s-30s, the years of Väinämöinen: the pale blue-grey of the lakes, white pine, blue
        // and white bands across the turret roofs, blue funnel bands, summer awnings over the quarterdeck
        "treaty": {
          "from": "generic/treaty",
          "desc": "Finland-inspired 1920s-30s: lake blue-grey, white pine, blue-white turret bands, awnings",
          "palette": {"recog_a": "#1f4a8a", "recog_b": "#f1efe8", "funnel_band": "#1f4a8a"},
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "tint": ["#7f9fc2", 0.55], "styles": ["warship", "carrier", "planing"]},
            {"keys": "wood", "tint": ["#e3d9bf", 0.9], "styles": ["warship", "carrier", "planing"]}
          ],
          "turrets": "round",
          "shapes": {"funnel_band_w": 0.7, "turret_bands": ["recog_a", "recog_b"], "awnings": true, "blocks": "soft"}
        },
        // Finland-inspired: Winter War white, a fleet frozen into the ice: snow white under grey and black panels
        // over hull, upperworks and decks, black funnel caps, round turrets
        "wwii": {
          "from": "generic/wwii",
          "desc": "Finland-inspired: Winter War white under grey and black panels, decks too",
          "palette": {
            "hull": "#d9dbd8", "deck": "#c9ccc9", "wood": "#d6d2c4", "deck_line": "#9a968a", "steel_line": "#8a8e8c",
            "levels": ["#e3e5e2", "#e7e9e6", "#ebedea", "#eff0ee"], "turret": "#dfe1de", "barbette": "#c4c7c4",
            "funnel": "#e1e3e0", "funnel_cap": "#1b1d1f", "funnel_band": "#1b1d1f", "mast": "#3a3e42",
            "camo": ["#8d9397", "#1e2124"]
          },
          "turrets": "round",
          "shapes": {"funnel": "oval", "dazzle": true, "dazzle_decks": 0.5, "dazzle_upperworks": 0.8},
          "shapes_by_style": {"merchant": {"dazzle": false}}
        },
        // Finland-inspired 1950s-60s: today's coastal camouflage forty years early, green, black and pale grey panels
        // over a green-grey, decks dark green, numbers. Louder than the other navies' muted Cold War, by choice
        "cold_war": {
          "from": "generic/cold_war",
