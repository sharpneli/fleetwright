        "great_war": {
          "from": "generic/great_war",
          "desc": "Japan-inspired 1910s: dark green-grey, red-brown decks, white funnel bands, two-tier tops",
          "palette": {"funnel_band": "#ecebe4"},
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "tint": ["#3f4744", 0.55], "styles": ["warship", "carrier", "planing"]},
            {"keys": "wood", "tint": ["#8e5a3c", 1.0], "styles": ["warship", "carrier", "planing"]}
          ],
          "turrets": "classic",
          "shapes": {"blocks": "soft", "top_tiers": 2, "top_r": 2.0, "funnel_band_w": 0.7}
        },
        // Japan-inspired 1920s-30s: the Kure look before the rebuilds: smaller early pagodas, finer bows
        "treaty": {
          "from": "wwii",
          "desc": "Japan-inspired 1920s-30s: Kure grey, chocolate linoleum decks, early pagodas",
          "adjust": [
            {"keys": "wood", "tint": ["#6b4635", 1.0], "styles": ["warship", "carrier", "planing"]},
            {"keys": "deck_line", "tint": ["#b39050", 1.0], "styles": ["warship", "carrier", "planing"]}
          ],
          "shapes": {"top_r": 2.6, "top_tiers": 2, "deck_line_opacity": 0.6}
        },
        // Japan-inspired: dark Kure grey, pale hinoki wood, brown linoleum on steel decks, black-topped funnels,
