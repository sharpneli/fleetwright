          ],
          "turrets": "round",
          "shapes": {"funnel_band_w": 0.7, "awnings": true}
        },
        // Sweden-inspired, neutral again: light grey, blue and yellow bands on the turret roofs and diagonal
        // stripes at both ends of the deck, for the aircraft of either side to see; slab turrets
        "wwii": {
          "from": "generic/wwii",
          "desc": "Sweden-inspired: light grey, blue and yellow neutrality marks on turrets and both deck ends",
          "palette": {"recog_a": "#2a5a9e", "recog_b": "#e3b630", "funnel_band": "#1d2023"},
          "adjust": [
            {"keys": ["hull", "upperworks", "armament", "funnels"], "lighten": 0.12, "styles": ["warship", "carrier", "planing"]}
          ],
          "turrets": "slab",
          "shapes": {
