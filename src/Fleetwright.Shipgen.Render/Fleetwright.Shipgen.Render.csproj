<Project Sdk="Microsoft.NET.Sdk">

  <!-- The drawing side: looks, the display list and the sprite layout (PORTING.md Step 4). Reads only the built
       ship dict; the design side never draws. -->
  <PropertyGroup>
    <RootNamespace>Fleetwright.Shipgen.Render</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleetwright.Shipgen\Fleetwright.Shipgen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\looks.jsonc" LogicalName="looks.jsonc" />
    <EmbeddedResource Include="Data\dejavu-sans-bold.glyphs.json" LogicalName="dejavu-sans-bold.glyphs.json" />
    <EmbeddedResource Include="$(ContentRoot)Shaders\Compiled\shipbake.vert.spv" LogicalName="shipbake.vert.spv" />
    <EmbeddedResource Include="$(ContentRoot)Shaders\Compiled\shipbake.frag.spv" LogicalName="shipbake.frag.spv" />
  </ItemGroup>

</Project>
