<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Fleetwright</RootNamespace>
    <AssemblyName>Fleetwright</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="ppy.SDL3_image-CS" />
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="ImGui.NET" />
    <PackageReference Include="TracyWrapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleetwright.Gpu\Fleetwright.Gpu.csproj" />
    <!-- the ship viewer (-ship=...), a test tool for the Shipgen port -->
    <ProjectReference Include="..\Fleetwright.Shipgen\Fleetwright.Shipgen.csproj" />
    <ProjectReference Include="..\Fleetwright.Shipgen.Render\Fleetwright.Shipgen.Render.csproj" />
  </ItemGroup>

  <!-- Content/ lives at the repo root and is shared with the Shipgen renderer. -->
  <ItemGroup>
    <None Include="$(ContentRoot)Shaders\Compiled\**\*"
          Link="Content\Shaders\Compiled\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Game assets: the data the game ships with (release.bat). Each lands in the output under its Link path, in
       builds and publishes alike, and code finds it there through AppContext.BaseDirectory. Not everything in the
       repo is an asset: shipgen/designs/fuzz/ and the goldens are test data. -->
  <ItemGroup>
    <GameAsset Include="$(MSBuildThisFileDirectory)..\..\shipgen\designs\*.json" Link="Content\Designs\%(Filename)%(Extension)" />
    <None Include="@(GameAsset)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
