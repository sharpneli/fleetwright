<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- No background GC: one started by a test running alongside skews another thread's
         GC.GetAllocatedBytesForCurrentThread by a few KB of its allocation quantum, so the "allocates nothing" tests
         failed on garbage nobody made (pure arithmetic blamed). Blocking GCs count exactly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fleetwright.Sim.Core\Fleetwright.Sim.Core.csproj" />
    <ProjectReference Include="..\..\src\Fleetwright.Sim\Fleetwright.Sim.csproj" />
    <ProjectReference Include="..\..\src\Fleetwright.Sim.Ships\Fleetwright.Sim.Ships.csproj" />
    <ProjectReference Include="..\..\src\Fleetwright.Sim.Combat\Fleetwright.Sim.Combat.csproj" />
    <ProjectReference Include="..\..\src\Fleetwright.Sim.Ai\Fleetwright.Sim.Ai.csproj" />
    <ProjectReference Include="..\..\src\Fleetwright.Sim.Missions\Fleetwright.Sim.Missions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
